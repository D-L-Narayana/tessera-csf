{
  "name": "tessera",
  "private": true,
  "version": "0.2.0",
  "description": "Browser-local NIST CSF 2.0 evidence mapper: freshness, contradiction and residual-risk engine with traceable reviewer decisions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check:dist": "node qa/check-dist.mjs",
    "qa:serve": "node qa/serve-dist.mjs --port 6120"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.0",
    "@fontsource/public-sans": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
